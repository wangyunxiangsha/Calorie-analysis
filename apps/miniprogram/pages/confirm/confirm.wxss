.page {
  padding: 24rpx;
  padding-bottom: 48rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.food-name {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
}
.food-meta {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}
.field {
  margin-bottom: 24rpx;
}
.field:last-child {
  margin-bottom: 0;
}
.label {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}
.meal-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.meal-chip {
  padding: 12rpx 28rpx;
  background: #f0f4f8;
  border-radius: 32rpx;
  font-size: 26rpx;
}
.meal-chip.active {
  background: #1a7f5a;
  color: #fff;
}
.serving-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin: 16rpx 0;
}
.serving-val {
  font-size: 36rpx;
  font-weight: 600;
  min-width: 160rpx;
  text-align: center;
}
.hint {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  display: block;
}
.section-title {
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}
.preview-grid {
  display: flex;
  justify-content: space-between;
}
.pv {
  text-align: center;
}
.num {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a7f5a;
  display: block;
}
.unit {
  font-size: 22rpx;
  color: #888;
}
.btn-primary {
  background: #1a7f5a;
  color: #fff;
  border-radius: 48rpx;
  margin-top: 8rpx;
}
