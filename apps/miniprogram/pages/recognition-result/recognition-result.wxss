.page {
  padding: 24rpx;
  padding-bottom: 48rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.head-title {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}
.head-sub {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}
.head-warn {
  font-size: 24rpx;
  color: #c45c26;
  margin-top: 12rpx;
  display: block;
}
.candidate {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid #f0f0f0;
}
.candidate:last-child {
  border-bottom: none;
}
.candidate.unmatched {
  opacity: 0.92;
}
.candidate-main {
  flex: 1;
  min-width: 0;
}
.candidate-name {
  font-size: 30rpx;
  font-weight: 500;
  display: block;
}
.candidate-meta {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
  display: block;
}
.candidate-tag {
  font-size: 22rpx;
  color: #1b7a5a;
  margin-top: 8rpx;
  display: inline-block;
  background: #e8f5ef;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.candidate-tag.warn {
  color: #c45c26;
  background: #fff4e5;
}
.candidate-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 16rpx;
}
.confidence {
  font-size: 26rpx;
  color: #666;
}
.arrow {
  font-size: 36rpx;
  color: #ccc;
}
.actions {
  margin-top: 8rpx;
}
.btn-secondary {
  background: #f0f4f8;
  color: #333;
  border-radius: 48rpx;
  margin-bottom: 20rpx;
}
.btn-link {
  background: transparent;
  color: #888;
  font-size: 26rpx;
}
