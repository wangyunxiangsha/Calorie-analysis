.page {
  padding: 24rpx 24rpx 48rpx;
}
.hero {
  padding: 32rpx 8rpx 24rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 600;
  display: block;
}
.sub {
  margin-top: 12rpx;
  color: #666;
  font-size: 26rpx;
  display: block;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.field {
  margin-bottom: 28rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.row {
  display: flex;
  gap: 24rpx;
}
.chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
input,
.picker {
  background: #f0f4f8;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
}
.modes {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.mode-item {
  border: 2rpx solid #e8ecef;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}
.mode-item.active {
  border-color: #1a7f5a;
  background: #f0faf5;
}
.mode-name {
  font-weight: 600;
  display: block;
}
.mode-desc {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
  display: block;
}
.disclaimer {
  font-size: 22rpx;
  color: #c45c26;
  line-height: 1.5;
  margin-top: 8rpx;
}
.btn-primary {
  margin-top: 32rpx;
  background: #1a7f5a;
  color: #fff;
  border-radius: 48rpx;
}
