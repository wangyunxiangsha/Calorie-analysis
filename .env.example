# Copy to apps/api/.env

DATABASE_URL="postgresql://calorie:calorie_dev@localhost:5432/calorie_analysis?schema=public"

JWT_SECRET="change-me-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
ADMIN_JWT_SECRET="change-me-admin-secret-min-32-chars"

WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# Default admin (seed): admin / admin123 — change in production
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="admin123"

PORT=3000
CORS_ORIGIN="http://localhost:5173"

# 餐图存储（本地或 Zeabur 持久卷，见 docs/ZEABUR.md）
UPLOAD_DIR=uploads/meals
UPLOAD_STATIC_ROOT=
PUBLIC_BASE_URL=http://localhost:3000

# M2: 拍照识别 — 推荐智谱 GLM 视觉（支持图片）
# 在 https://open.bigmodel.cn/usercenter/proj-mgmt/apikeys 申请
ZHIPU_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 识别速度优先（推荐）：glm-4v-flash；精度更高可改 glm-4.6v
LLM_VISION_MODEL=glm-4v-flash
LLM_PROVIDER=zhipu
# 也可用 LLM_API_KEY= 代替 ZHIPU_API_KEY
# glm-4.6v 较慢，Zeabur 建议 LLM_TIMEOUT_MS≥180000
LLM_TIMEOUT_MS=180000
RECOGNITION_JOB_TIMEOUT_MS=200000

# 备选：DeepSeek V4（官方 API 目前不支持图片，仅适合纯文本）
# DEEPSEEK_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_VISION_MODEL=deepseek-v4-flash
# LLM_PROVIDER=deepseek
