.page {
  padding-bottom: 120rpx;
}
.mode-strip {
  height: 8rpx;
  background: #1b7a5a;
}
.date-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
}
.nav-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 40rpx;
  color: #1b7a5a;
  font-weight: 600;
}
.nav-btn.disabled {
  color: #ccc;
}
.date-picker-hit {
  flex: 1;
  text-align: center;
  padding: 0 16rpx;
}
.date-picker-hit .date-label {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}
.date-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}
.today-link {
  font-size: 24rpx;
  color: #1b7a5a;
  margin-top: 4rpx;
}
.trend-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.trend-entry-title {
  font-size: 30rpx;
  font-weight: 600;
}
.trend-entry-sub {
  font-size: 26rpx;
  color: #888;
}
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 24rpx 8rpx;
}
.header-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.mode-tag {
  font-size: 24rpx;
  color: #1b7a5a;
  align-self: flex-start;
}
.status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.status-ok {
  background: #e8f5ef;
  color: #1b7a5a;
}
.status-warn {
  background: #fff4e5;
  color: #c45c26;
}
.status-over {
  background: #fdecea;
  color: #c62828;
}
.summary .calorie-big {
  margin-bottom: 20rpx;
}
.num {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.unit {
  font-size: 28rpx;
  color: #888;
  margin-left: 8rpx;
}
.remain {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #444;
}
.remain .over {
  color: #c62828;
}
.trend-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}
.trend-range {
  font-size: 22rpx;
  color: #999;
}
.trend-legend {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
  font-size: 22rpx;
}
.trend-legend .leg.cal::before,
.trend-legend .leg.pro::before {
  content: '';
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}
.trend-legend .leg.cal::before {
  background: #1a7f5a;
}
.trend-legend .leg.pro::before {
  background: #4a90d9;
}
.trend-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  padding: 0 4rpx;
}
.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}
.trend-col.today .day-label {
  color: #1a7f5a;
  font-weight: 600;
}
.bar-stack {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 140rpx;
  width: 100%;
  justify-content: center;
}
.cal-bar-wrap,
.pro-bar-wrap {
  width: 14rpx;
  height: 100%;
  background: #eef2f5;
  border-radius: 6rpx 6rpx 0 0;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.cal-bar {
  width: 100%;
  background: #1a7f5a;
  border-radius: 6rpx 6rpx 0 0;
  min-height: 4rpx;
}
.pro-bar {
  width: 100%;
  background: #4a90d9;
  border-radius: 6rpx 6rpx 0 0;
  min-height: 4rpx;
}
.trend-val {
  font-size: 18rpx;
  color: #888;
  margin-top: 8rpx;
}
.day-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}
.trend-summary {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}
.macros-card .macro-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 12rpx;
}
.macros-card .macro-row:last-child {
  margin-bottom: 0;
}
.macro-label {
  width: 56rpx;
  font-size: 24rpx;
  color: #666;
}
.macro-bar-wrap {
  flex: 1;
  height: 12rpx;
  background: #eef2f5;
  border-radius: 6rpx;
  overflow: hidden;
}
.macro-bar {
  height: 100%;
  border-radius: 6rpx;
  max-width: 100%;
}
.macro-val {
  width: 140rpx;
  text-align: right;
  font-size: 22rpx;
  color: #666;
}
.logs-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.section-title {
  font-weight: 600;
  font-size: 30rpx;
}
.count {
  font-size: 24rpx;
  color: #999;
}
.log-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid #f5f5f5;
}
.log-item:last-child {
  border-bottom: none;
}
.log-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.meal-tag {
  font-size: 22rpx;
  background: #f0f4f8;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #666;
}
.log-name {
  font-size: 28rpx;
}
.log-cal {
  color: #1b7a5a;
  font-weight: 500;
}
.empty-logs {
  text-align: center;
  padding: 48rpx 32rpx;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}
.empty-sub {
  font-size: 26rpx;
  color: #888;
  margin: 12rpx 0 32rpx;
  display: block;
}
.btn-add {
  background: #1b7a5a;
  color: #fff;
  border-radius: 40rpx;
  width: 280rpx;
}
.loading {
  text-align: center;
  padding: 80rpx;
}
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  background: #1b7a5a;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  box-shadow: 0 8rpx 32rpx rgba(26, 127, 90, 0.4);
  z-index: 10;
}
